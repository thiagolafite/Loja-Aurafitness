# ==============================================================================
# VARIÁVEIS DE AMBIENTE - AURA FITNESS (PRODUÇÃO & PREVIEW/DEV)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Frontend & Client-Side)
# Configurar no painel do Supabase -> Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# ------------------------------------------------------------------------------
# 2. SUPABASE (Backend / Vercel Serverless Functions ONLY)
# NUNCA expor esta chave no front-end (apenas nas variáveis de ambiente da Vercel)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta-aqui

# ------------------------------------------------------------------------------
# 3. GATEWAY DE PAGAMENTO (Mercado Pago)
# Configurar no painel Mercado Pago Developers (Credenciais de Teste / Produção)
# ------------------------------------------------------------------------------
# Chave pública para o front-end (Checkout Bricks):
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Access Token privado (usado APENAS nas funções serverless em /api):
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx

# Chave secreta de assinatura do Webhook (para validação HMAC-SHA256 em x-signature):
MERCADOPAGO_WEBHOOK_SECRET=sua-chave-secreta-do-webhook-aqui
MERCADO_PAGO_WEBHOOK_SECRET=sua-chave-secreta-do-webhook-aqui

# ------------------------------------------------------------------------------
# 4. URL DA APLICAÇÃO
# ------------------------------------------------------------------------------
VITE_APP_URL=https://aurafitness.vercel.app
